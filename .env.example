# Optional Docker Compose overrides. Compose reads .env automatically; defaults
# are shown below. These are the retry and resource Settings Compose passes through.
# Keep this file free of secrets: the selected public model needs no token.
TRANSCRIBER_MAX_UPLOAD_BYTES=4294967296
TRANSCRIBER_MODEL_LOAD_TIMEOUT=600
TRANSCRIBER_RETRY_MAX_ATTEMPTS=3
TRANSCRIBER_RETRY_DELAY_SECONDS=1
TRANSCRIBER_RETRY_MAX_DELAY_SECONDS=10
TRANSCRIBER_PROCESSING_TIMEOUT=7200
TRANSCRIBER_CLEANUP_GRACE=60
TRANSCRIBER_WORKER_MAX_TASKS_PER_CHILD=5
